+#!/usr/bin/env python3
+"""Build a useful HTML-first home from the same verified snapshot as search pages."""
+import csv
+import html
+import io
+import json
+import sys
+from pathlib import Path
+from datetime import date
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path: sys.path.insert(0,str(ROOT))
+PUB = ROOT / 'public'
+SITE = 'https://flscratchstats.com'
+PRICES = [1, 2, 3, 5, 10, 20, 30, 50]
+
+def esc(value): return html.escape(str(value if value is not None else ''), quote=True)
+def money(value):
