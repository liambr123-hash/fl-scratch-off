+        content = "<h1>" + html.escape(heading) + "</h1>\n" + content
+    # Replace the legacy two-app jump with the real inline-detail contract.
+    content = re.sub(r'(<a\b[^>]*href=)([\"\'])/#game/([A-Za-z0-9_-]+)\2([^>]*>).*?</a>',
